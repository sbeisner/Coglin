# Copy to .dev.vars (gitignored) for local development.
# Production/staging values are set with:
#   wrangler secret put <NAME> --env <staging|production>

# Extra entropy mixed into session token hashing. Generate with:
#   openssl rand -hex 32
SESSION_PEPPER=

# Gates POST /api/auth/coach-signup. Unset means signup is closed, not open.
ALPHA_SIGNUP_CODE=

# Resend key for invite mail (COG-041). Safe to leave blank locally: invites are
# still created and the dialog shows a copyable link, which is all you need to
# walk the accept flow. Shared with Inkubus — see inkubus/backend/.env.local.
RESEND_API_KEY=

# Stripe, for the pay-what-you-think-is-fair page at /pricing (COG-047). Leave
# blank and the pay button answers 503 — the rest of the app does not care.
#
# The secret key is SHARED with Inkubus (website/inkubus/.dev.vars). The webhook
# secret is NOT: it belongs to one endpoint. Locally it is whatever
#   stripe listen --forward-to localhost:5174/api/billing/webhook
# prints when you start it, and it changes each run.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile, guarding /api/billing/checkout — a public endpoint that
# creates Stripe sessions is a card-testing target. Blank means the challenge is
# skipped, which is what you want locally.
#
# PAIRED WITH VITE_TURNSTILE_SITE_KEY. The page only sends a token when the site
# key is built into the bundle, and the server rejects a missing token whenever
# this secret is set — so setting one without the other makes every checkout
# fail with `challenge_failed`. Set both or neither.
TURNSTILE_SECRET_KEY=

# Public Turnstile site key. Read at BUILD time by Vite (import.meta.env), not at
# runtime, so changing it needs a rebuild — and on staging/production it must be
# present in the environment that runs `npm run build`, not set as a Worker
# secret. Not a secret: it ships in the client bundle.
VITE_TURNSTILE_SITE_KEY=
